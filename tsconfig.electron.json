{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "outDir": ".electron-dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "electron"],
    "sourceMap": true,
    "declaration": false
  },
  "include": [
    "electron/**/*.ts",
    "app/lib/pomodoro/types.ts",
    "app/lib/pomodoro/engine.ts",
    "app/lib/pomodoro/format.ts"
  ],
  "exclude": ["node_modules"]
}
