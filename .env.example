## Prisma (SQLite)
# Local file-based database for development.
DATABASE_URL="file:./dev.db"

# Docker Compose bind-mounts the project root and uses the same dev.db file:
# DATABASE_URL="file:/workspace/dev.db"

## Development behind nginx / custom domain (optional)
# Comma-separated hosts allowed to load `/_next/*` in `next dev` (production ignores this).
# Example local domain proxied to PORT 3060:
ALLOWED_DEV_ORIGINS=nml.localhost

